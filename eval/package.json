{
  "name": "sheets-ai-pipeline-eval",
  "private": true,
  "description": "Evaluation harness for the paper. Kept separate from the root package so the add-on itself stays zero-dependency. HyperFormula (GPL-3.0) is used only as an independent spreadsheet-engine oracle for ground-truth labels and execution accuracy; it is never loaded by the add-on.",
  "scripts": {
    "e1": "node --expose-gc --max-old-space-size=6144 e1_detection.js --tag main --seeds 12 --detectors none,syntax,lint,v1,v2,v2-structural,v2-symbols,v2-bounds,v2-shape,v2-grounding,v2-circular,v2-query",
    "e2": "node e2_retrieval.js",
    "e3": "node e3_scalability.js",
    "e4": "node e4_ssrf.js",
    "e5": "sh run_e5_final.sh",
    "e6": "node e6_llm_critic.js --backend ollama:llama3.1:8b --per-class 15 --clean 300 --out results/e6_critic.jsonl",
    "e5-hosted": "sh run_e5_hosted.sh",
    "e5-seeds": "sh run_e5_seeds.sh",
    "analysis": "sh run_analysis.sh",
    "assets": "node make_paper_assets.js && python make_figures.py",
    "check-paper": "python check_paper.py",
    "gsheets-pack": "node --expose-gc --max-old-space-size=6144 gsheets/make_pack.js && node gsheets/selftest.js",
    "check-v21": "node --expose-gc --max-old-space-size=6144 check_v21_equivalence.js"
  },
  "dependencies": {
    "hyperformula": "3.4.0"
  }
}
